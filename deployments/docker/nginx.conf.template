# Serves the UI and proxies the API, webhook ingress and WebSockets to the api service.
# ${PORT}, ${API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS} are filled in from the environment when the container starts.
# The upstream goes through a variable so its name is re-resolved (a redeployed api gets a new address).
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
  set $api_upstream ${API_UPSTREAM};
  listen ${PORT};
  listen [::]:${PORT};
  root /usr/share/nginx/html;

  location /api/ { proxy_pass $api_upstream; include /etc/nginx/synapse-proxy.conf; }
  location /hooks/ { proxy_pass $api_upstream; include /etc/nginx/synapse-proxy.conf; }
  location /ws/ {
    proxy_pass $api_upstream;
    include /etc/nginx/synapse-proxy.conf;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
  }
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location / { try_files $uri /index.html; add_header Cache-Control "no-cache"; }
}
