# One image recipe for every Go service: docker build --build-arg APP=api|worker|scheduler
FROM golang:1.27-alpine AS build
ARG APP
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN test -n "$APP" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service ./apps/$APP

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget && adduser -D -u 10001 synapse
COPY --from=build /out/service /usr/local/bin/synapse
USER synapse
# api listens on 8080; worker and scheduler expose /metrics and health on 8081
EXPOSE 8080 8081
ENTRYPOINT ["/usr/local/bin/synapse"]
