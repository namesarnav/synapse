FROM node:22-alpine AS build
WORKDIR /repo
COPY packages/protocol ./packages/protocol
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN cd apps/web && npm ci
COPY apps/web ./apps/web
RUN cd apps/web && npm run build

FROM nginx:1.27-alpine
COPY deployments/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deployments/docker/synapse-proxy.conf /etc/nginx/synapse-proxy.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
# The nginx image renders /etc/nginx/templates with these at start; override for other platforms.
ENV PORT=8080 API_UPSTREAM=http://api:8080
EXPOSE 8080
